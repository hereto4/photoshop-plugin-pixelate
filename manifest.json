{
  "manifestVersion": 5,
  "id": "com.phatmojo.true-pixelate",
  "name": "True Pixelate",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "27.0.0",
    "data": {
      "apiVersion": 2
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "truePixelate",
      "label": {
        "default": "True Pixelate"
      },
      "minimumSize": {
        "width": 220,
        "height": 290
      },
      "maximumSize": {
        "width": 800,
        "height": 900
      },
      "preferredDockedSize": {
        "width": 240,
        "height": 365
      },
      "preferredFloatingSize": {
        "width": 300,
        "height": 395
      }
    },
    {
      "type": "command",
      "id": "pixelate16",
      "label": {
        "default": "Pixelate to 16 px"
      }
    },
    {
      "type": "command",
      "id": "pixelate32",
      "label": {
        "default": "Pixelate to 32 px"
      }
    },
    {
      "type": "command",
      "id": "pixelate64",
      "label": {
        "default": "Pixelate to 64 px"
      }
    },
    {
      "type": "command",
      "id": "pixelate128",
      "label": {
        "default": "Pixelate to 128 px"
      }
    },
    {
      "type": "command",
      "id": "pixelate256",
      "label": {
        "default": "Pixelate to 256 px"
      }
    },
    {
      "type": "command",
      "id": "pixelate512",
      "label": {
        "default": "Pixelate to 512 px"
      }
    },
    {
      "type": "command",
      "id": "pixelate1024",
      "label": {
        "default": "Pixelate to 1024 px"
      }
    }
  ],
  "icons": [
    {
      "width": 24,
      "height": 24,
      "path": "icons/dark.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "darkest",
        "dark",
        "medium"
      ],
      "species": [
        "generic"
      ]
    },
    {
      "width": 24,
      "height": 24,
      "path": "icons/light.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "lightest",
        "light"
      ],
      "species": [
        "generic"
      ]
    }
  ]
}
